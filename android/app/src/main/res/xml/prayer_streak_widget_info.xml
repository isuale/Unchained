<?xml version="1.0" encoding="utf-8"?>
<!-- Metadata for the "Prayer Streak" home-screen widget. See
     PrayerStreakWidgetProvider.kt for what it shows and how it animates. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="140dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_prayer_streak"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/prayer_streak_widget_label" />
