<?xml version="1.0" encoding="utf-8"?>
<!-- Config for FeedGuardService. No packageNames filter: we need a window-state
     event for EVERY foreground change (including the home launcher) so we can
     tell when the user has left a tracked app — filtering to only the target
     packages would mean no event fires on exit, and the daily timer would keep
     counting forever. Target packages are filtered in code instead. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="100"
    android:description="@string/feed_guard_description" />
