<?xml version="1.0" encoding="utf-8"?>
<!-- Policies for UnchainedDeviceAdminReceiver. Being an active admin is what blocks
     uninstall; no privileged policy is needed for that, so the set is intentionally
     empty to keep the activation prompt minimal. (Device-owner uninstall blocking
     is granted by the owner role, not by anything declared here.) -->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies />
</device-admin>
