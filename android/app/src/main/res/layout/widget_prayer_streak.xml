<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_prayer_streak_bg_0">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/widget_flame_glow"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:src="@drawable/widget_flame_glow" />

            <ImageView
                android:id="@+id/widget_flame"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_flame"
                android:contentDescription="@string/prayer_streak_widget_label" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_streak_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF"
                android:textSize="34sp"
                android:textStyle="bold"
                tools:text="12" />

            <TextView
                android:id="@+id/widget_streak_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#99FFFFFF"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textStyle="bold"
                tools:text="DAY STREAK" />

            <TextView
                android:id="@+id/widget_milestone_caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                tools:text="4 TO NEXT MILESTONE" />

            <FrameLayout
                android:id="@+id/widget_progress_track"
                android:layout_width="120dp"
                android:layout_height="5dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/widget_progress_track">

                <ImageView
                    android:id="@+id/widget_progress_fill"
                    android:layout_width="120dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="start"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_progress_fill" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
