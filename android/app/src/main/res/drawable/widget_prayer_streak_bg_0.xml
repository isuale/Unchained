<?xml version="1.0" encoding="utf-8"?>
<!-- Card background, tier 0 (no streak yet): neutral border. Tiers 1-4 are
     identical except for a border tinted to that tier's flame color, so the
     whole card warms up along with the flame as the streak grows — set at
     runtime via RemoteViews.setInt(widget_root, "setBackgroundResource", ...)
     in PrayerStreakWidgetProvider. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="#0F1420"
        android:endColor="#05070C" />
    <corners android:radius="22dp" />
    <stroke android:width="1dp" android:color="#26FFFFFF" />
</shape>
