<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded card matching the app's dark theme (surface #0A0F1C, primary
     blue #1E5FFF as a faint border) so the widget reads as part of the app
     rather than a generic system widget. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#0A0F1C" />
    <corners android:radius="20dp" />
    <stroke android:width="1dp" android:color="#331E5FFF" />
</shape>
