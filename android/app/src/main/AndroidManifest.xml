<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required so the VPN service can open sockets to forward non-blocked DNS queries
         upstream. Flutter only auto-adds this to the debug manifest, so release builds
         fail every socket() with EPERM without it. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Uninstall protection: lets the accessibility watchdog draw the scripture lock
         over Settings, and (because the app holds it) start that activity from the
         background when an "escape door" is detected. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Lets BootReceiver hear ACTION_BOOT_COMPLETED so protection survives a
         phone restart instead of silently staying off. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="Be Unchained"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Deep link so Stripe's "payment successful" page can reopen the app
                 (unchained://paid). singleTop above brings the running app forward
                 instead of launching a second copy. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="unchained" android:host="paid" />
            </intent-filter>
        </activity>

        <service
            android:name=".BlockingService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="dns_filtering" />
        </service>

        <!-- Uninstall-protection watchdog. The user must enable it by hand under
             Settings > Accessibility; the system binds it via BIND_ACCESSIBILITY_SERVICE. -->
        <service
            android:name=".UninstallGuardService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/uninstall_guard_config" />
        </service>

        <!-- Feed guard: daily time budgets for Instagram Reels / YouTube Shorts /
             TikTok / Snapchat Stories. The user must enable it by hand under
             Settings > Accessibility, same as the uninstall-protection watchdog. -->
        <service
            android:name=".FeedGuardService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/feed_guard_config" />
        </service>

        <!-- Restarts the blocking VPN after a reboot (or an app update), so
             restarting the phone is no longer a way to shed protection. -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Hard uninstall block. While this admin is active the system refuses to
             uninstall the app until it is deactivated; if the app is promoted to
             device owner it can block uninstall outright. -->
        <receiver
            android:name=".UnchainedDeviceAdminReceiver"
            android:label="@string/device_admin_label"
            android:description="@string/device_admin_explanation"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Lets url_launcher resolve a mail app for the "report a bug" mailto:
             link in the footer / Terms screen on Android 11+ (package visibility). -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <!-- Lets url_launcher open the Stripe hosted checkout page (and any
             https link) in a browser on Android 11+ (package visibility). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- Lets the prayer app-locker enumerate every launchable app so the
             user can pick which ones to lock behind prayer. Querying by the
             MAIN/LAUNCHER intent gives visibility to all home-screen apps
             without the sensitive QUERY_ALL_PACKAGES permission. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
</manifest>
